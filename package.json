{
  "name": "dsh-units",
  "version": "0.5.0",
  "description": "Unit conversion toolbox for DeepSeek Harness (dsh): length, mass, temperature, area, volume (incl. cooking), speed, time, data sizes (decimal MB vs binary MiB), data transfer rates (Mbps vs MB/s), acceleration (m/s², g-force), illumination (lux, foot-candle), pressure, energy, angle, frequency, power (mechanical/metric/electric horsepower), force, torque, typography (px/pt/em/rem), volumetric flow rate (m³/s, L/min, CFM, gpm), density (kg/m³, g/cm³, lb/ft³, lb/gal), fuel economy (mpg ↔ L/100km) — plus a unit-price tool that normalizes and ranks price-per-unit offers; zero runtime dependencies",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint src test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "units",
    "unit-conversion",
    "converter",
    "data-sizes",
    "data-transfer-rate",
    "acceleration",
    "g-force",
    "illumination",
    "measurement",
    "typography",
    "css-units",
    "fuel-economy",
    "power",
    "horsepower",
    "force",
    "torque",
    "volumetric-flow-rate",
    "density",
    "unit-price",
    "price-comparison"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TYEclipse/dsh-units.git"
  },
  "bugs": {
    "url": "https://github.com/TYEclipse/dsh-units/issues"
  },
  "homepage": "https://github.com/TYEclipse/dsh-units#readme",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "3.2.0",
    "oxlint": "^1.6.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
